# ==============================================
# Parable Mall - Environment Variables
# ==============================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요.
# cp .env.example .env.local
#
# [REQUIRED] = 필수, [OPTIONAL] = 선택, [FUTURE] = 추후 구현 시 필요

# ---- Database (GCP Cloud SQL) [REQUIRED] ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/parable_mall?sslmode=require"
# 로컬 개발 시: postgresql://parable:parable_dev_password@localhost:5432/parable_mall
# Vercel 배포 시: Cloud SQL 공개 IP + SSL 인증서 사용

# ---- Redis (Upstash) [REQUIRED] ----
UPSTASH_REDIS_REST_URL=""   # https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN="" # AXxx...

# ---- NextAuth [REQUIRED] ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # openssl rand -base64 32 로 생성

# ---- OAuth Providers [OPTIONAL — 소셜 로그인 사용 시] ----
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ---- Payment (토스페이먼츠) [REQUIRED — 결제 시] ----
TOSS_CLIENT_KEY=""  # 테스트: test_ck_xxx, 운영: live_ck_xxx
TOSS_SECRET_KEY=""  # 테스트: test_sk_xxx, 운영: live_sk_xxx
NEXT_PUBLIC_TOSS_CLIENT_KEY="" # 프론트에서 결제창 호출용

# ---- File Storage (Cloudflare R2) [REQUIRED — 이미지 업로드 시] ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="parable-mall"
R2_PUBLIC_URL="" # https://pub-xxx.r2.dev 또는 커스텀 도메인

# ---- Email [FUTURE] ----
# RESEND_API_KEY=""

# ---- 카카오 알림톡 [FUTURE] ----
# ALIMTALK_API_KEY=""
# ALIMTALK_SENDER_KEY=""

# ---- Analytics [OPTIONAL] ----
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Sentry [OPTIONAL] ----
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# ---- App [REQUIRED] ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Vercel 배포 시: https://shop.parable-ent.com
